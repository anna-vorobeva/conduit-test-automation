# Copy to .env and adjust if needed. Values below match docker-compose.yml defaults.

# Conduit under test
UI_BASE_URL=http://127.0.0.1:4100
API_BASE_URL=http://127.0.0.1:8000/api

# PostgreSQL: used by docker-compose to init the database and by tests for direct SQL checks
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit
POSTGRES_DB=conduit
